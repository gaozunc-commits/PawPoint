@model CheckoutVM
@inject DB db
@inject Helper hp
@{
    ViewBag.Title = "Order Checkout";
    var cart = hp.GetCart();
    var pIds = cart.Keys.ToList();
    var products = db.Products.Where(p => pIds.Contains(p.Id)).ToList();
    decimal subtotal = products.Sum(p => p.Price * cart.GetValueOrDefault(p.Id, 0));
    int customerPoints = ViewBag.CustomerPoints ?? 0;
    decimal maxDiscount = Math.Min(subtotal, customerPoints / 10.0m);
}

<div style="display: grid; grid-template-columns: 3fr 2fr; gap: 25px; max-width: 850px;">
    <div>
        <h3>Delivery &amp; Payment Details</h3>
        <form class="form" method="post">
            <div asp-validation-summary="ModelOnly"></div>

            <label asp-for="DeliveryAddress"></label>
            <textarea asp-for="DeliveryAddress" autofocus placeholder="Unit, Street Address, Postal Code, City, State..." style="width: 100%; height: 70px;"></textarea>
            <span asp-validation-for="DeliveryAddress"></span>

            <label asp-for="PaymentMethod"></label>
            <select asp-for="PaymentMethod" style="width: 100%; padding: 6px;">
                <option value="Card">Online Card / Stripe Simulation</option>
                <option value="Deposit">Bank Transfer / Deposit</option>
                <option value="Cash">Cash on Delivery</option>
            </select>
            <span asp-validation-for="PaymentMethod"></span>

            @if (customerPoints >= 10)
            {
                <label>Loyalty Points</label>
                <div style="background: #e8f5e9; padding: 10px; border-radius: 4px; border: 1px solid #c8e6c9;">
                    <label style="cursor: pointer; font-weight: bold; color: #2e7d32;">
                        <input asp-for="RedeemPoints" type="checkbox"> Redeem available points for discount (Up to RM @maxDiscount.ToString("0.00") off)
                    </label>
                    <div style="font-size: 12px; color: #555; margin-top: 4px;">You have <b>@customerPoints points</b>. 10 points = RM 1.00 instant discount.</div>
                </div>
                <span></span>
            }

            <section style="margin-top: 15px;">
                <button type="submit" style="background: #28a745; color: #fff; font-size: 16px; padding: 8px 20px;">Place Order Now</button>
                <button type="button" data-get="/Product/Cart">Back to Cart</button>
            </section>
        </form>
    </div>

    <div style="border: 1px solid #ddd; padding: 15px; border-radius: 6px; background: #fafafa; align-self: start;">
        <h4 style="margin-top: 0;">Order Summary</h4>
        <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
            @foreach (var p in products)
            {
                int q = cart.GetValueOrDefault(p.Id, 0);
                <tr>
                    <td style="padding: 6px 0; border-bottom: 1px solid #eee;">
                        <b>@p.Name</b><br>
                        <small style="color: #666;">@q &times; RM @p.Price.ToString("0.00")</small>
                    </td>
                    <td style="padding: 6px 0; border-bottom: 1px solid #eee; text-align: right; font-weight: bold;">
                        RM @((p.Price * q).ToString("0.00"))
                    </td>
                </tr>
            }
            <tr>
                <td style="padding: 10px 0 4px; font-weight: bold;">Estimated Subtotal:</td>
                <td style="padding: 10px 0 4px; text-align: right; font-weight: bold;">RM @subtotal.ToString("0.00")</td>
            </tr>
            <tr>
                <td style="padding: 4px 0; color: #666;">Standard Delivery:</td>
                <td style="padding: 4px 0; text-align: right; color: #28a745; font-weight: bold;">FREE</td>
            </tr>
        </table>
        <div style="margin-top: 10px; padding-top: 10px; border-top: 2px solid #ddd; display: flex; justify-content: space-between; font-size: 16px; font-weight: bold;">
            <span>Total Payable:</span>
            <span style="color: #28a745;">RM @subtotal.ToString("0.00")</span>
        </div>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />
