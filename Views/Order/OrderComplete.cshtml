@model Order
@{
    ViewBag.Title = "Order Confirmation";
    decimal total = Model?.OrderLines.Sum(l => l.Price * l.Quantity) ?? 0;
}

<div style="background: #e8f5e9; border: 1px solid #c8e6c9; border-radius: 6px; padding: 25px; max-width: 650px; text-align: center; margin: 0 auto;">
    <div style="font-size: 48px;">🎉</div>
    <h2 style="color: #2e7d32; margin: 10px 0;">Order #@Model?.Id Placed Successfully!</h2>
    <p style="color: #555;">An official e-receipt and dispatch confirmation notice have been sent to your email.</p>

    <div style="background: #fff; border: 1px solid #ddd; border-radius: 4px; padding: 15px; text-align: left; margin: 20px 0;">
        <table class="table detail" style="width: 100%;">
            <tr><th style="width: 140px;">Order ID:</th><td>#@Model?.Id</td></tr>
            <tr><th>Order Date:</th><td>@Model?.Date.ToString("yyyy-MM-dd")</td></tr>
            <tr><th>Payment Status:</th><td><span class="badge" style="background: @(Model?.Paid == true ? "#28a745" : "#f0ad4e");">@(Model?.Paid == true ? "PAID" : "PENDING")</span></td></tr>
            <tr><th>Delivery To:</th><td>@Model?.DeliveryAddress</td></tr>
            <tr><th>Total Amount:</th><td style="font-weight: bold; color: #28a745; font-size: 16px;">RM @total.ToString("0.00")</td></tr>
        </table>
    </div>

    <div style="display: flex; gap: 10px; justify-content: center;">
        <button data-get="/Order/OrderDetail/@Model?.Id">View Order Details</button>
        <button data-get="/Order/OrderHistory">Order History</button>
        <button data-get="/Product/Catalog">Continue Shopping</button>
    </div>
</div>
