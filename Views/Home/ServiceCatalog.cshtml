@model X.PagedList.IPagedList<Service>
@using X.PagedList.Mvc.Core
@{
    ViewBag.Title = "Services Catalog";
}

<form data-ajax="true"
      data-ajax-update="#target"
      data-ajax-loading="#loader"
      id="f"
      style="display: flex; gap: 10px; align-items: center; margin-bottom: 15px; flex-wrap: wrap;">
    @Html.TextBox("name", "", new { type = "search", placeholder = "Search service name...", autofocus = "", data_trim = "", style = "padding: 6px 10px; min-width: 220px;" })

    <select name="branchId" onchange="$(this.form).submit();" style="padding: 6px 10px;">
        <option value="">- All Branches -</option>
        @if (ViewBag.Branches != null)
        {
            foreach (Branch b in ViewBag.Branches)
            {
                <option value="@b.Id" selected="@(Context.Request.Query["branchId"] == b.Id)">@b.Name</option>
            }
        }
    </select>

    <button type="submit">Search</button>
    <button type="reset">Reset</button>
    <img src="/images/loader.gif" id="loader" style="display: none; height: 24px;">
</form>

<div id="target">
    <partial name="_ServiceCatalog" model="Model" />
</div>

@section foot {
    <script>
        let timer = null;
        $('#name').on('input', e => {
            clearTimeout(timer);
            timer = setTimeout(() => $(e.target.form).submit(), 400);
        });
    </script>
}
