@model ServiceInsertVM
@{
    ViewBag.Title = "Add Grooming Service";
}

<form class="form" method="post" enctype="multipart/form-data" style="max-width: 600px;">
    <div asp-validation-summary="ModelOnly"></div>

    <label asp-for="Id"></label>
    <input asp-for="Id" autofocus placeholder="SV001" data-upper style="width: 100%;">
    <span asp-validation-for="Id"></span>

    <label asp-for="Name"></label>
    <input asp-for="Name" data-trim style="width: 100%;">
    <span asp-validation-for="Name"></span>

    <label asp-for="Description"></label>
    <textarea asp-for="Description" style="width: 100%; height: 60px;"></textarea>
    <span asp-validation-for="Description"></span>

    <label asp-for="Price"></label>
    <input asp-for="Price" type="number" step="0.01" min="0.01" max="999.99" style="width: 100%;">
    <span asp-validation-for="Price"></span>

    <label asp-for="DurationMinutes"></label>
    <input asp-for="DurationMinutes" type="number" min="10" max="240" step="5" style="width: 100%;">
    <span asp-validation-for="DurationMinutes"></span>

    <label asp-for="BranchId"></label>
    <select asp-for="BranchId" asp-items="ViewBag.BranchId" style="width: 100%; padding: 6px;"></select>
    <span asp-validation-for="BranchId"></span>

    <label asp-for="Photo"></label>
    <div class="upload">
        <label style="cursor: pointer;">
            <input asp-for="Photo" type="file" accept="image/jpeg,image/png" style="display: none;">
            <img src="/photos/photo.jpg" alt="Preview" style="width: 120px; height: 120px; border-radius: 4px; border: 2px dashed #999;">
        </label>
        <br><small style="color: #666;">Click photo to upload service image</small>
    </div>
    <span asp-validation-for="Photo"></span>

    <section>
        <button type="submit">Save Service</button>
        <button type="button" data-get="/Service/Index">Cancel</button>
    </section>
</form>

<partial name="_ValidationScriptsPartial" />
