@model ProductUpdateVM
@{
    ViewBag.Title = "Update Product";
}

<form class="form" method="post" enctype="multipart/form-data" style="max-width: 600px;">
    <div asp-validation-summary="ModelOnly"></div>

    <label asp-for="Id"></label>
    <input asp-for="Id" readonly style="background: #eee; width: 100%;">
    <span asp-validation-for="Id"></span>

    <label asp-for="Name"></label>
    <input asp-for="Name" data-trim style="width: 100%;">
    <span asp-validation-for="Name"></span>

    <label asp-for="Description"></label>
    <textarea asp-for="Description" style="width: 100%; height: 60px;"></textarea>
    <span asp-validation-for="Description"></span>

    <label asp-for="Price"></label>
    <input asp-for="Price" type="number" step="0.01" min="0.01" max="999.99" style="width: 100%;">
    <span asp-validation-for="Price"></span>

    <label asp-for="Stock"></label>
    <input asp-for="Stock" type="number" min="0" max="9999" style="width: 100%;">
    <span asp-validation-for="Stock"></span>

    <label asp-for="Photo"></label>
    <div class="upload">
        <label style="cursor: pointer;">
            <input asp-for="Photo" type="file" accept="image/jpeg,image/png" style="display: none;">
            <img src="/products/@(Model.PhotoURL ?? "photo.jpg")" alt="Preview" style="width: 120px; height: 120px; border-radius: 4px; border: 2px dashed #999;" onerror="this.src='/photos/photo.jpg'">
        </label>
        <br><small style="color: #666;">Click photo to change image (optional)</small>
    </div>
    <span asp-validation-for="Photo"></span>

    <section>
        <button type="submit">Update Product</button>
        <button type="button" data-get="/Product/Catalog">Cancel</button>
    </section>
</form>

<partial name="_ValidationScriptsPartial" />
