@model BranchInsertVM
@{
    ViewBag.Title = "Add New Branch";
}

<form class="form" method="post" style="max-width: 550px;">
    <div asp-validation-summary="ModelOnly"></div>

    <label asp-for="Id"></label>
    <input asp-for="Id" autofocus placeholder="BR001" data-upper style="width: 100%;">
    <span asp-validation-for="Id"></span>

    <label asp-for="Name"></label>
    <input asp-for="Name" data-trim style="width: 100%;">
    <span asp-validation-for="Name"></span>

    <label asp-for="Address"></label>
    <textarea asp-for="Address" style="width: 100%; height: 60px;"></textarea>
    <span asp-validation-for="Address"></span>

    <label asp-for="Phone"></label>
    <input asp-for="Phone" placeholder="03-12345678" data-trim style="width: 100%;">
    <span asp-validation-for="Phone"></span>

    <label asp-for="Latitude"></label>
    <input asp-for="Latitude" type="number" step="0.000001" placeholder="3.1478" style="width: 100%;">
    <span asp-validation-for="Latitude"></span>

    <label asp-for="Longitude"></label>
    <input asp-for="Longitude" type="number" step="0.000001" placeholder="101.6953" style="width: 100%;">
    <span asp-validation-for="Longitude"></span>

    <section>
        <button type="submit">Save Branch</button>
        <button type="button" data-get="/Branch/Index">Cancel</button>
    </section>
</form>

<partial name="_ValidationScriptsPartial" />
