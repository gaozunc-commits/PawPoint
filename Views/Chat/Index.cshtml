@{
    ViewBag.Title = "Live Customer & Staff Support Chat";
    string userName = ViewBag.UserName;
    string userRole = ViewBag.UserRole;
}

<div style="background: #fdf7e7; border-left: 4px solid #f0ad4e; padding: 12px 15px; margin-bottom: 20px; max-width: 700px; border-radius: 4px;">
    <b>💬 Real-Time Live Support (SignalR)</b><br>
    Connected as <b>@userName</b> (<span class="badge">@userRole</span>). Send a message below to chat live with branch groomers and customer support.
</div>

<div style="max-width: 700px; border: 1px solid #ddd; border-radius: 8px; overflow: hidden; background: #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">
    <div style="background: #666; color: #fff; padding: 12px 15px; font-weight: bold; display: flex; justify-content: space-between; align-items: center;">
        <span>PawPoint Support Lounge</span>
        <span id="chatStatus" style="font-size: 12px; background: #28a745; padding: 3px 8px; border-radius: 10px;">🟢 Connected</span>
    </div>

    <div id="messagesList" style="height: 380px; overflow-y: auto; padding: 15px; background: #fcfcfc; display: flex; flex-direction: column; gap: 10px;">
        <div style="text-align: center; color: #999; font-size: 13px; margin-bottom: 10px;">
            --- Joined Support Channel ---
        </div>
    </div>

    <div style="padding: 12px; background: #eee; border-top: 1px solid #ddd; display: flex; gap: 10px;">
        <input type="text" id="messageInput" placeholder="Type your message here..." autofocus style="flex: 1; padding: 8px 12px; border: 1px solid #ccc; border-radius: 4px; font-size: 15px;">
        <button type="button" id="sendButton" style="padding: 8px 20px; background: #0275d8; color: #fff; font-weight: bold; border-radius: 4px;">Send</button>
    </div>
</div>

@section foot {
    <script>
        const currentUser = "@userName";
        const currentRole = "@userRole";

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveMessage", function (user, role, message, time) {
            const isMe = (user === currentUser);
            const msgDiv = document.createElement("div");
            msgDiv.style.alignSelf = isMe ? "flex-end" : "flex-start";
            msgDiv.style.maxWidth = "75%";
            msgDiv.style.background = isMe ? "#d1ecf1" : "#f8f9fa";
            msgDiv.style.border = isMe ? "1px solid #bee5eb" : "1px solid #ddd";
            msgDiv.style.borderRadius = "8px";
            msgDiv.style.padding = "8px 12px";

            let roleBadgeColor = (role === "Admin") ? "#dc3545" : ((role === "Staff") ? "#0275d8" : "#28a745");

            msgDiv.innerHTML = `
                <div style="font-size: 12px; margin-bottom: 4px; display: flex; justify-content: space-between; gap: 10px;">
                    <span><b>${user}</b> <span style="background:${roleBadgeColor}; color:#fff; padding:1px 5px; border-radius:3px; font-size:10px;">${role}</span></span>
                    <span style="color: #888;">${time}</span>
                </div>
                <div style="font-size: 14px; color: #333; word-break: break-word;">${message}</div>
            `;

            const list = document.getElementById("messagesList");
            list.appendChild(msgDiv);
            list.scrollTop = list.scrollHeight;
        });

        connection.start().then(function () {
            document.getElementById("chatStatus").textContent = "🟢 Connected";
        }).catch(function (err) {
            document.getElementById("chatStatus").textContent = "🔴 Offline";
            console.error(err.toString());
        });

        function doSend() {
            const input = document.getElementById("messageInput");
            const msg = input.value.trim();
            if (msg.length > 0) {
                connection.invoke("SendMessage", msg).catch(function (err) {
                    return console.error(err.toString());
                });
                input.value = "";
            }
        }

        document.getElementById("sendButton").addEventListener("click", doSend);
        document.getElementById("messageInput").addEventListener("keypress", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                doSend();
            }
        });
    </script>
}
