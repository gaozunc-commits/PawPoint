@model ResetPasswordVM
@{
    ViewBag.Title = "Reset Password";
}

<div style="background: #fdf7e7; border-left: 4px solid #f0ad4e; padding: 12px 15px; margin-bottom: 20px; max-width: 480px; border-radius: 4px;">
    Enter your registered email address. We will generate a secure temporary password and email it to you.
</div>

<form class="form" method="post" style="max-width: 450px;">
    <div asp-validation-summary="ModelOnly"></div>

    <label asp-for="Email"></label>
    <input asp-for="Email" autofocus data-trim style="width: 100%;">
    <span asp-validation-for="Email"></span>

    <label>Security Check</label>
    <div style="display: flex; align-items: center; gap: 10px;">
        <span class="badge" style="font-size: 16px; padding: 6px 12px; background: #555;">@ViewBag.CaptchaQuestion</span>
        <input asp-for="Captcha" placeholder="Answer" style="width: 100px;">
    </div>
    <span asp-validation-for="Captcha"></span>

    <section>
        <button type="submit">Send Reset Password Email</button>
        <button type="button" data-get="/Account/Login">Back to Login</button>
    </section>
</form>

<partial name="_ValidationScriptsPartial" />
