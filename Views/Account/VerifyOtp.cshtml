@model VerifyOtpVM
@{
    ViewBag.Title = "Verify Email OTP";
}

<div style="background: #e8f4fd; border-left: 4px solid #0275d8; padding: 12px 15px; margin-bottom: 20px; max-width: 480px; border-radius: 4px;">
    <b>📧 OTP Verification Required</b><br>
    We have sent a 6-digit one-time verification password to <b>@Model.Email</b>. Please enter it below to activate your account.
</div>

<form class="form" method="post" style="max-width: 450px;">
    <div asp-validation-summary="ModelOnly"></div>

    <label asp-for="Email"></label>
    <input asp-for="Email" readonly style="background: #eee; width: 100%;">
    <span asp-validation-for="Email"></span>

    <label asp-for="Otp">6-Digit OTP</label>
    <input asp-for="Otp" maxlength="6" autofocus placeholder="123456" style="font-size: 20px; letter-spacing: 4px; text-align: center; width: 160px;">
    <span asp-validation-for="Otp"></span>

    <section>
        <button type="submit">Verify &amp; Activate Account</button>
        <button type="button" data-get="/Account/Register">Re-enter Email</button>
    </section>
</form>

<partial name="_ValidationScriptsPartial" />
