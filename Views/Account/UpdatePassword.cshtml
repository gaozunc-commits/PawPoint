@model UpdatePasswordVM
@{
    ViewBag.Title = "Change Password";
}

<form class="form" method="post" style="max-width: 480px;">
    <div asp-validation-summary="ModelOnly"></div>

    <label asp-for="Current"></label>
    <input asp-for="Current" autofocus style="width: 100%;">
    <span asp-validation-for="Current"></span>

    <label asp-for="New"></label>
    <input asp-for="New" style="width: 100%;">
    <span asp-validation-for="New"></span>

    <label asp-for="ConfirmNew"></label>
    <input asp-for="ConfirmNew" style="width: 100%;">
    <span asp-validation-for="ConfirmNew"></span>

    <section>
        <button type="submit">Update Password</button>
        <button type="reset">Reset</button>
    </section>
</form>

<partial name="_ValidationScriptsPartial" />
