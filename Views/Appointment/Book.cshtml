@model AppointmentBookVM
@{
    ViewBag.Title = "Book Grooming Appointment";
}

<div style="background: #e8f4fd; border-left: 4px solid #0275d8; padding: 12px 15px; margin-bottom: 20px; max-width: 650px; border-radius: 4px;">
    <b>💡 Appointment Booking Tips:</b><br>
    Select your pet, choose a branch, pick multiple grooming services, and choose a preferred date &amp; time. You can check the <a href="/Appointment/Availability" target="_blank" style="color: #0275d8; font-weight: bold;">Availability Matrix Grid</a> to see real-time staff openings.
</div>

<form class="form" method="post" style="max-width: 650px;">
    <div asp-validation-summary="ModelOnly"></div>

    <label asp-for="PetId"></label>
    @if (ViewBag.PetList != null && ((IEnumerable<SelectListItem>)ViewBag.PetList).Any())
    {
        <select asp-for="PetId" asp-items="ViewBag.PetList" style="width: 100%; padding: 6px;"></select>
    }
    else
    {
        <div>
            <span style="color: red;">You have no registered pets.</span>
            <button type="button" data-get="/Pet/Insert" style="margin-left: 10px;">+ Add Pet First</button>
        </div>
    }
    <span asp-validation-for="PetId"></span>

    <label asp-for="BranchId"></label>
    <select asp-for="BranchId" asp-items="ViewBag.BranchList" onchange="location = '?branchId=' + this.value;" style="width: 100%; padding: 6px;"></select>
    <span asp-validation-for="BranchId"></span>

    <label>Select Services</label>
    <div>
        <partial name="_CheckBoxList" model='("ServiceIds", ViewBag.ServiceList, false)' />
        <div style="margin-top: 5px;">
            <a href="#" data-check="ServiceIds" style="font-size: 13px;">Check All</a> |
            <a href="#" data-uncheck="ServiceIds" style="font-size: 13px;">Uncheck All</a>
        </div>
    </div>
    <span asp-validation-for="ServiceIds"></span>

    <label asp-for="StaffEmail"></label>
    <select asp-for="StaffEmail" asp-items="ViewBag.StaffList" style="width: 100%; padding: 6px;">
        <option value="">-- Auto-Assign Available Staff --</option>
    </select>
    <span asp-validation-for="StaffEmail"></span>

    <label asp-for="Date"></label>
    <input asp-for="Date" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" style="width: 100%; padding: 6px;">
    <span asp-validation-for="Date"></span>

    <label asp-for="TimeSlot"></label>
    <select asp-for="TimeSlot" style="width: 100%; padding: 6px;">
        <option value="09:00:00">09:00 AM</option>
        <option value="10:00:00">10:00 AM</option>
        <option value="11:00:00">11:00 AM</option>
        <option value="14:00:00">02:00 PM</option>
        <option value="15:00:00">03:00 PM</option>
        <option value="16:00:00">04:00 PM</option>
    </select>
    <span asp-validation-for="TimeSlot"></span>

    <label asp-for="Notes"></label>
    <textarea asp-for="Notes" placeholder="Special grooming instructions or pet behavioral notes..." style="width: 100%; height: 60px;"></textarea>
    <span asp-validation-for="Notes"></span>

    <section>
        <button type="submit">Confirm &amp; Book Appointment</button>
        <button type="button" data-get="/Appointment/MyAppointments">My Bookings</button>
    </section>
</form>

<partial name="_ValidationScriptsPartial" />
