@model Appointment
@{
    ViewBag.Title = "Appointment #" + Model?.Id + " Summary";
    decimal total = Model?.AppointmentServices.Sum(s => s.Price) ?? 0;
    string qrData = Url.Action("QrCheckIn", "Appointment", new { id = Model?.Id }, Context.Request.Scheme) ?? $"https://pawpoint.test/Appointment/QrCheckIn/{Model?.Id}";
    string qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=180x180&data={Uri.EscapeDataString(qrData)}";
}

@if (Model == null)
{
    <p>Appointment record not found.</p>
}
else
{
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; max-width: 800px;">
        <div>
            <table class="table detail">
                <tr>
                    <th style="width: 140px;">Appointment ID</th>
                    <td><b>#@Model.Id</b></td>
                </tr>
                <tr>
                    <th>Status</th>
                    <td><span class="badge" style="padding: 4px 10px; font-size: 14px;">@Model.Status</span></td>
                </tr>
                <tr>
                    <th>Date &amp; Time</th>
                    <td><b>@Model.Date.ToString("yyyy-MM-dd")</b> at <b>@Model.TimeSlot.ToString("hh:mm tt")</b></td>
                </tr>
                <tr>
                    <th>Branch</th>
                    <td><b>@Model.Branch?.Name</b><br><small style="color: #666;">@Model.Branch?.Address (Tel: @Model.Branch?.Phone)</small></td>
                </tr>
                <tr>
                    <th>Pet</th>
                    <td>
                        <img src="/pets/@Model.Pet?.PhotoURL" style="width: 32px; height: 32px; border-radius: 50%; vertical-align: middle;" onerror="this.src='/photos/photo.jpg'">
                        <b>@Model.Pet?.Name</b> (@Model.Pet?.Species - @Model.Pet?.Breed)
                    </td>
                </tr>
                <tr>
                    <th>Staff Groomer</th>
                    <td>@(Model.Staff?.Name ?? "Auto-assigned by branch") (@Model.Staff?.Email)</td>
                </tr>
                <tr>
                    <th>Notes</th>
                    <td>@(string.IsNullOrEmpty(Model.Notes) ? "None" : Model.Notes)</td>
                </tr>
            </table>

            <h3 style="margin-top: 20px;">Booked Grooming Services</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Duration</th>
                        <th style="text-align: right;">Price</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sv in Model.AppointmentServices)
                    {
                        <tr>
                            <td><b>@sv.Service?.Name</b></td>
                            <td>@sv.Service?.DurationMinutes min</td>
                            <td style="text-align: right; color: #28a745; font-weight: bold;">RM @sv.Price.ToString("0.00")</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="2" style="text-align: right; font-weight: bold;">Estimated Total:</td>
                        <td style="text-align: right; font-weight: bold; color: #28a745; font-size: 16px;">RM @total.ToString("0.00")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div style="border: 1px solid #ddd; padding: 15px; border-radius: 6px; text-align: center; background: #fafafa; align-self: start;">
            <h4 style="margin-top: 0;">📱 QR Check-In</h4>
            <p style="font-size: 12px; color: #666;">Present this QR code upon arrival at the branch reception:</p>
            <img src="@qrUrl" alt="Appointment QR Code" style="width: 150px; height: 150px; border: 1px solid #ccc; padding: 4px; background: #fff; border-radius: 4px;">
            @if (!User.IsInRole("Customer"))
            {
                <div style="margin-top: 10px;">
                    <button data-get="/Appointment/QrCheckIn/@Model.Id" style="width: 100%; padding: 8px;">Simulate QR Scan Check-In</button>
                </div>
            }
        </div>
    </div>

    <div style="margin-top: 20px;">
        @if (User.IsInRole("Staff") || User.IsInRole("Admin"))
        {
            <button data-get="/Appointment/StaffIndex">Back to Appointments List</button>
            <button data-get="/Appointment/UpdateStatus/@Model.Id">Update Status</button>
        }
        else
        {
            <button data-get="/Appointment/MyAppointments">Back to My Bookings</button>
        }
    </div>
}
